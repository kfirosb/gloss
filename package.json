{
  "name": "language-assistant",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write src tests desktop scripts/*.mjs *.ts *.json index.html",
    "format:check": "prettier --check src tests desktop scripts/*.mjs *.ts *.json index.html",
    "test": "vitest run",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build",
    "test:e2e": "playwright test",
    "start": "node dist/server/runtime/cli.js",
    "desktop": "npm run build && electron .",
    "predesktop:package": "node scripts/check-tmux.mjs && node scripts/check-whisper.mjs",
    "desktop:package": "npm run build && electron-builder --mac --dir",
    "predesktop:dmg": "node scripts/check-tmux.mjs && node scripts/check-whisper.mjs",
    "desktop:dmg": "npm run build && electron-builder --mac dmg",
    "desktop:install": "sh scripts/install-mac.sh",
    "build:tmux": "sh scripts/build-tmux.sh",
    "build:whisper": "sh scripts/build-whisper.sh",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vitejs/plugin-react": "6.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "8.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "local.language-assistant",
    "productName": "Gloss",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "desktop/**",
      "dist/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gloss uses the microphone to dictate into the composer."
      }
    },
    "afterPack": "scripts/adhoc-sign.mjs",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "vendor/tmux/bin/tmux",
        "to": "bin/tmux"
      },
      {
        "from": "vendor/tmux/TMUX-LICENSE",
        "to": "licenses/TMUX-LICENSE"
      },
      {
        "from": "vendor/tmux/LIBEVENT-LICENSE",
        "to": "licenses/LIBEVENT-LICENSE"
      },
      {
        "from": "vendor/whisper/bin/whisper-server",
        "to": "bin/whisper-server"
      },
      {
        "from": "vendor/whisper/WHISPER-LICENSE",
        "to": "licenses/WHISPER-LICENSE"
      }
    ]
  }
}
