{
  "name": "gloss",
  "version": "0.21.0",
  "private": true,
  "description": "Work with Codex and Claude Code in your own language",
  "homepage": "https://github.com/kfirosb/gloss",
  "author": {
    "name": "kfirosb",
    "email": "kfirosb@users.noreply.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write src tests desktop scripts/*.mjs *.ts *.json index.html",
    "format:check": "prettier --check src tests desktop scripts/*.mjs *.ts *.json index.html",
    "test": "vitest run",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build",
    "test:e2e": "playwright test",
    "start": "node dist/server/runtime/cli.js",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --mac --dir",
    "desktop:dmg": "npm run build && electron-builder --mac dmg",
    "desktop:install": "sh scripts/install-mac.sh",
    "predesktop:linux": "node scripts/check-linux-vendor.mjs",
    "desktop:linux": "npm run build && node scripts/stage-linux-node-pty.mjs && electron-builder --linux -c.npmRebuild=false",
    "build:linux-vendor": "sh scripts/build-linux-vendor.sh x64 && sh scripts/build-linux-vendor.sh arm64",
    "build:tmux": "sh scripts/build-tmux.sh",
    "build:whisper": "sh scripts/build-whisper.sh",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vitejs/plugin-react": "6.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "8.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "io.github.kfirosb.gloss",
    "productName": "Gloss",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "desktop/**",
      "dist/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gloss uses the microphone to dictate into the composer."
      },
      "extraResources": [
        {
          "from": "vendor/tmux/${arch}/bin/tmux",
          "to": "bin/tmux"
        },
        {
          "from": "vendor/tmux/TMUX-LICENSE",
          "to": "licenses/TMUX-LICENSE"
        },
        {
          "from": "vendor/tmux/LIBEVENT-LICENSE",
          "to": "licenses/LIBEVENT-LICENSE"
        },
        {
          "from": "vendor/whisper/${arch}/bin/whisper-server",
          "to": "bin/whisper-server"
        },
        {
          "from": "vendor/whisper/WHISPER-LICENSE",
          "to": "licenses/WHISPER-LICENSE"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "gloss",
      "synopsis": "Work with Codex and Claude Code in your own language",
      "desktop": {
        "entry": {
          "StartupWMClass": "gloss"
        }
      },
      "extraResources": [
        {
          "from": "vendor/linux-${arch}/bin/tmux",
          "to": "bin/tmux"
        },
        {
          "from": "vendor/linux-${arch}/TMUX-LICENSE",
          "to": "licenses/TMUX-LICENSE"
        },
        {
          "from": "vendor/linux-${arch}/LIBEVENT-LICENSE",
          "to": "licenses/LIBEVENT-LICENSE"
        },
        {
          "from": "vendor/linux-${arch}/bin/whisper-server",
          "to": "bin/whisper-server"
        },
        {
          "from": "vendor/linux-${arch}/WHISPER-LICENSE",
          "to": "licenses/WHISPER-LICENSE"
        },
        {
          "from": "vendor/linux-${arch}/NODE-PTY-LICENSE",
          "to": "licenses/NODE-PTY-LICENSE"
        }
      ]
    },
    "deb": {
      "packageName": "gloss",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "lsof",
        "libgbm1",
        "libasound2t64 | libasound2",
        "libtinfo6"
      ],
      "recommends": [
        "ripgrep",
        "sound-theme-freedesktop",
        "pulseaudio-utils"
      ]
    },
    "beforePack": "scripts/check-vendor.mjs",
    "afterPack": "scripts/sign-mac.mjs",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  }
}
