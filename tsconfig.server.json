{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/server",
    "declaration": true,
    "lib": ["ES2023"]
  },
  "include": [
    "src/core/**/*.ts",
    "src/runtime/**/*.ts",
    "src/language/**/*.ts",
    "src/agents/**/*.ts"
  ],
  "exclude": ["src/ui"]
}
